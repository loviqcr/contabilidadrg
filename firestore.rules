rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Libro contable único, compartido por todos los usuarios del negocio
    // (admin y empleados) — cualquiera con una cuenta ve y edita lo mismo.
    match /business/{docId} {
      allow read, create, delete: if request.auth != null;
      // Desde que movimientos/deudas/etc. se guardan por partes en chunks/,
      // el documento principal debe venir marcado con schemaVersion 2 y sin
      // esos arrays. Esto rechaza los guardados de una versión vieja de la
      // app que alguien tenga abierta (guarda el libro entero con su copia),
      // que de otro modo reviviría datos viejos encima de los nuevos.
      allow update: if request.auth != null
        && request.resource.data.schemaVersion == 2
        && !request.resource.data.keys().hasAny(['transactions', 'deudas', 'mermas', 'regalias', 'pagosEfectivo']);

      // Movimientos, deudas, mermas, regalías y pagos en efectivo, repartidos
      // por mes (un documento por tipo y mes).
      match /chunks/{chunkId} {
        allow read, write: if request.auth != null;
      }

      // Copia intacta del documento principal previa a la migración a
      // chunks. Se puede crear y leer, pero no modificar ni borrar.
      match /backups/{backupId} {
        allow read, create: if request.auth != null;
      }

      match /products/{productId} {
        allow read, write: if request.auth != null;
      }

      match /comprobantes/{comprobanteId} {
        allow read, write: if request.auth != null;
      }
    }

    // Modelo anterior (un libro por usuario). Se deja solo para que la
    // migración de una sola vez pueda leer los datos viejos del admin.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /products/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Solo los admins pueden leer el directorio de usuarios. La escritura ocurre
    // al crear la cuenta (ver createUserAsAdmin), momento en el que quien está
    // autenticado es el usuario recién creado, no el admin — mismo modelo de
    // riesgo aceptado que la creación de cuentas en sí (ver auditoría).
    match /userDirectory/{uid} {
      allow read: if request.auth != null && request.auth.token.email in ["loviqcr@gmail.com", "ygarcia@rgtropical.local"];
      allow write: if request.auth != null;
    }

    // Mapeo usuario→correo interno, para poder iniciar sesión con un nombre de
    // usuario en vez de un correo. Debe poder leerse sin estar autenticado
    // todavía (es lo que se consulta justo antes de iniciar sesión).
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
